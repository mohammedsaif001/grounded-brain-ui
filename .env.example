# Base URL of the grounded-brain API (grounded-brain-notebook-llm).
# Read at build time (rewrites) and at runtime (server-side fetches). Required in production.
API_URL=http://localhost:8080

# Optional: timeout in ms for server-side calls to the API (default 10000).
# API_TIMEOUT_MS=10000

# Public origin used for canonical URLs, sitemap, robots and social cards (e.g. https://grounded-brain.imohdsaif.in). Set in production.
# SITE_URL=http://localhost:3000
